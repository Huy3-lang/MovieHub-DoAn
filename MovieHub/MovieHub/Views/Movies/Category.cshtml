@model IEnumerable<MovieHub.Models.Movie>

@{
    ViewData["Title"] = ViewBag.CategoryName ?? "Thể loại";
}

<div class="container py-5">

    ```
    <!-- TIÊU ĐỀ -->
    <div class="section-title mb-4">

        <div>

            <span class="section-small-title">
                MOVIEHUB
            </span>

            <h2>
                🎭 @ViewBag.CategoryName
            </h2>

        </div>

        <a asp-controller="Home"
           asp-action="Index"
           class="view-all">

            ← Trang chủ

        </a>

    </div>


    <!-- BỘ LỌC -->
    <div class="movie-filter-box">

        <form asp-controller="Movies"
              asp-action="Category"
              method="get"
              class="movie-filter-form">

            <input type="hidden"
                   name="id"
                   value="@ViewBag.CategoryId" />

            <div class="movie-filter-group">

                <label>
                    📅 Năm phát hành
                </label>

                <select name="year"
                        class="movie-filter-select">

                    <option value="">
                        Tất cả các năm
                    </option>

                    @foreach (var year in ViewBag.Years)
                    {
                        <option value="@year"
                                selected="@(ViewBag.SelectedYear == year)">

                            @year

                        </option>
                    }

                </select>

            </div>


            <button type="submit"
                    class="movie-filter-button">

                🔍 Lọc phim

            </button>


            @if (ViewBag.SelectedYear != null)
            {
                <a asp-controller="Movies"
                   asp-action="Category"
                   asp-route-id="@ViewBag.CategoryId"
                   class="movie-filter-reset">

                    ✕ Xóa bộ lọc

                </a>
            }

        </form>

    </div>


    <!-- SỐ LƯỢNG -->
    <div class="category-result-count">

        Tìm thấy
        <strong>@Model.Count()</strong>
        phim

        @if (ViewBag.SelectedYear != null)
        {
            <span>
                trong năm
                <strong>@ViewBag.SelectedYear</strong>
            </span>
        }

    </div>


    <!-- DANH SÁCH PHIM -->
    @if (Model.Any())
    {
        <div class="row g-4">

            @foreach (var movie in Model)
            {
                <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6">

                    <div class="movie-card">

                        <!-- POSTER -->

                        <div class="movie-poster-wrapper">

                            @if (!string.IsNullOrWhiteSpace(movie.PosterUrl))
                            {
                                <img src="@movie.PosterUrl"
                                     class="movie-poster"
                                     alt="@movie.Title" />
                            }
                            else
                            {
                                <div class="movie-poster movie-poster-empty">
                                    🎬
                                </div>
                            }

                            <div class="movie-overlay">

                                <a asp-controller="Movies"
                                   asp-action="Details"
                                   asp-route-id="@movie.Id"
                                   class="play-button">

                                    ▶

                                </a>

                            </div>

                            <div class="movie-year">
                                @movie.ReleaseYear
                            </div>

                        </div>


                        <!-- INFO -->

                        <div class="movie-info">

                            <h3 class="movie-title">
                                @movie.Title
                            </h3>


                            @{
                                var rating = ((IEnumerable<dynamic>)ViewBag.Ratings)
                                    .FirstOrDefault(r => r.MovieId == movie.Id);
                            }

                            @if (rating != null)
                            {
                                <div class="movie-rating-summary">

                                    ⭐ @rating.Average.ToString("0.0")

                                    <span>
                                        · @rating.Count đánh giá
                                    </span>

                                </div>
                            }
                            else
                            {
                                <div class="movie-rating-summary">

                                    ⭐ Chưa có đánh giá

                                </div>
                            }


                            <div class="movie-meta">

                                <span>
                                    📅 @movie.ReleaseYear
                                </span>

                                <span>
                                    ⏱ @movie.Duration phút
                                </span>

                            </div>


                            <div class="movie-category">

                                🎭 @movie.Category?.Name

                            </div>


                            <a asp-controller="Movies"
                               asp-action="Details"
                               asp-route-id="@movie.Id"
                               class="watch-button">

                                ▶ Xem phim

                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="search-empty">

            <div class="search-empty-icon">
                🔍
            </div>

            <h3>
                Không tìm thấy phim
            </h3>

            <p>
                Không có phim nào phù hợp với bộ lọc hiện tại.
            </p>

            <a asp-controller="Movies"
               asp-action="Category"
               asp-route-id="@ViewBag.CategoryId"
               class="btn btn-danger">

                Xem tất cả phim

            </a>

        </div>
    }
    ```

</div>
