@model IEnumerable<MovieHub.Models.Comment>

@{
    ViewData["Title"] = "Quản lý bình luận";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <span class="text-danger fw-bold">
                MOVIEHUB ADMIN
            </span>

            <h1 class="mt-1">
                💬 Quản lý bình luận
            </h1>
        </div>

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-secondary">

            ← Quản trị

        </a>

    </div>


    <div class="card shadow">

        <div class="card-body">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-dark">

                            <tr>
                                <th>ID</th>
                                <th>Người dùng</th>
                                <th>Phim</th>
                                <th>Nội dung</th>
                                <th>Thời gian</th>
                                <th>Thao tác</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var comment in Model)
                            {
                                <tr>

                                    <td>
                                        @comment.Id
                                    </td>

                                    <td>
                                        <strong>
                                            @comment.User?.Username
                                        </strong>
                                    </td>

                                    <td>
                                        @comment.Movie?.Title
                                    </td>

                                    <td style="min-width: 280px;">
                                        @comment.Content
                                    </td>

                                    <td>
                                        @comment.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>

                                        <form asp-controller="AdminComments"
                                              asp-action="Delete"
                                              asp-route-id="@comment.Id"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-danger btn-sm"
                                                    onclick="return confirm('Bạn có chắc chắn muốn xóa bình luận này không?');">

                                                🗑️ Xóa

                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <div style="font-size: 50px;">
                        💬
                    </div>

                    <h4 class="mt-3">
                        Chưa có bình luận
                    </h4>

                    <p class="text-muted">
                        Hiện tại chưa có bình luận nào trong hệ thống.
                    </p>

                </div>
            }

        </div>

    </div>

</div>