@model IEnumerable<MovieHub.Models.Episode>

@{
    ViewData["Title"] = "Quản lý tập phim";
}

<div class="container py-5">

    <!-- TIÊU ĐỀ -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <span class="text-danger fw-bold">
                MOVIEHUB ADMIN
            </span>

            <h1 class="mt-1">
                🎞️ Quản lý tập phim
            </h1>

        </div>

        <div>

            <a asp-controller="AdminEpisodes"
               asp-action="Create"
               class="btn btn-primary">

                ➕ Thêm tập

            </a>

            <a asp-controller="Admin"
               asp-action="Index"
               class="btn btn-secondary">

                ← Quản trị

            </a>

        </div>

    </div>


    <!-- BẢNG TẬP PHIM -->

    <div class="card shadow">

        <div class="card-body">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-dark">

                            <tr>

                                <th>ID</th>

                                <th>Phim</th>

                                <th>Tập</th>

                                <th>Tên tập</th>

                                <th>Video</th>

                                <th>Thao tác</th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var episode in Model)
                            {
                                <tr>

                                    <td>
                                        @episode.Id
                                    </td>


                                    <td>

                                        <strong>
                                            @episode.Movie?.Title
                                        </strong>

                                    </td>


                                    <td>

                                        <span class="badge bg-primary">

                                            Tập @episode.EpisodeNumber

                                        </span>

                                    </td>


                                    <td>
                                        @(episode.Title ?? "Chưa đặt tên")
                                    </td>


                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(episode.VideoUrl))
                                        {
                                            <span class="badge bg-success">

                                                ✅ Có video

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">

                                                ⚠ Chưa có

                                            </span>
                                        }

                                    </td>


                                    <td>

                                        <a asp-controller="AdminEpisodes"
                                           asp-action="Edit"
                                           asp-route-id="@episode.Id"
                                           class="btn btn-warning btn-sm">

                                            ✏️ Sửa

                                        </a>

                                        <form asp-controller="AdminEpisodes"
                                              asp-action="Delete"
                                              asp-route-id="@episode.Id"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-danger btn-sm"
                                                    onclick="return confirm('Bạn có chắc chắn muốn xóa tập này không?');">

                                                🗑️ Xóa

                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <div style="font-size: 50px;">
                        🎞️
                    </div>

                    <h4 class="mt-3">
                        Chưa có tập phim
                    </h4>

                    <p class="text-muted">
                        Hãy thêm tập phim đầu tiên.
                    </p>

                    <a asp-controller="AdminEpisodes"
                       asp-action="Create"
                       class="btn btn-primary">

                        ➕ Thêm tập

                    </a>

                </div>
            }

        </div>

    </div>

</div>