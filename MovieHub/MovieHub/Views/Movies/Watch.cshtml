@model MovieHub.Models.Episode

@{
    ViewData["Title"] = Model.Movie?.Title ?? "Xem phim";
}
<style>
    .movie-info-button {
        display: inline-block !important;
        padding: 10px 18px !important;
        background: #7c3aed !important;
        color: white !important;
        border-radius: 8px !important;
        text-decoration: none !important;
        font-weight: 600 !important;
    }

        .movie-info-button:hover {
            background: #6d28d9 !important;
            color: white !important;
            text-decoration: none !important;
        }
</style>

<div class="watch-page">

    <div class="container py-4">

        <!-- ĐƯỜNG DẪN -->
        <div class="watch-breadcrumb">

            <a asp-controller="Home"
               asp-action="Index">
                Trang chủ
            </a>

            <span>›</span>

            <a asp-controller="Movies"
               asp-action="Details"
               asp-route-id="@Model.MovieId">
                @Model.Movie?.Title
            </a>

            <span>›</span>

            <span>
                @Model.Title
            </span>

        </div>


        <!-- VIDEO -->
        <div class="video-section">

            <div class="video-container">

                @if (!string.IsNullOrWhiteSpace(Model.VideoUrl))
                {
                    <video controls
                           class="movie-video"
                           poster="@Model.Movie?.PosterUrl">

                        <source src="@Model.VideoUrl"
                                type="video/mp4" />

                        Trình duyệt của bạn không hỗ trợ phát video.

                    </video>
                }
                else
                {
                    <div class="video-empty">

                        <div class="video-empty-icon">
                            ▶
                        </div>

                        <h3>
                            Video chưa có
                        </h3>

                        <p>
                            Tập phim này hiện chưa có đường dẫn video.
                        </p>

                    </div>
                }

            </div>

        </div>


        <!-- THÔNG TIN ĐANG XEM -->
        <div class="watch-info">

            <div>

                <span class="watch-label">
                    ĐANG XEM
                </span>

                <h1>
                    @Model.Movie?.Title
                </h1>

                <h3>
                    @Model.Title
                </h3>

            </div>

            <a asp-controller="Movie"
               asp-action="Details"
               asp-route-id="@Model.MovieId"
               class="movie-info-button">
                ℹ️ Thông tin phim
            </a>


        </div>


        <!-- ĐIỀU HƯỚNG TẬP -->
        <div style="
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            margin: 20px 0;
            ">

            @if (ViewBag.PreviousEpisodeId != null)
            {
                <a asp-controller="Movies"
                   asp-action="Watch"
                   asp-route-id="@ViewBag.PreviousEpisodeId"
                   style="
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    padding: 10px 18px;
                    min-width: 120px;
                    background: #15151b;
                    border: 1px solid #444;
                    border-radius: 7px;
                    color: white;
                    text-decoration: none;
                    font-size: 14px;
                    font-weight: 600;
                    ">
                    ← Tập trước
                </a>
            }
            else
            {
                <span style="
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    padding: 10px 18px;
                    min-width: 120px;
                    background: #111;
                    border: 1px solid #333;
                    border-radius: 7px;
                    color: #666;
                    font-size: 14px;
                    font-weight: 600;
                    ">
                    ← Tập trước
                </span>
            }


            <div style="
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                min-width: 100px;
                ">
                <span style="
                    font-size: 11px;
                    color: #888;
                    text-transform: uppercase;
                    ">
                    Đang xem
                </span>

                <strong style="
                    font-size: 16px;
                    color: white;
                    margin-top: 3px;
                    ">
                    Tập @Model.EpisodeNumber
                </strong>
            </div>


            @if (ViewBag.NextEpisodeId != null)
            {
                <a asp-controller="Movies"
                   asp-action="Watch"
                   asp-route-id="@ViewBag.NextEpisodeId"
                   style="
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    padding: 10px 18px;
                    min-width: 120px;
                    background: #15151b;
                    border: 1px solid #444;
                    border-radius: 7px;
                    color: white;
                    text-decoration: none;
                    font-size: 14px;
                    font-weight: 600;
                    ">
                    Tập sau →
                </a>
            }
            else
            {
                <span style="
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    padding: 10px 18px;
                    min-width: 120px;
                    background: #111;
                    border: 1px solid #333;
                    border-radius: 7px;
                    color: #666;
                    font-size: 14px;
                    font-weight: 600;
                    ">
                    Tập sau →
                </span>
            }

        </div>


        <!-- DANH SÁCH TẬP -->
        @if (Model.Movie?.Episodes != null &&
             Model.Movie.Episodes.Any())
        {
            <div class="watch-episodes">

                <div class="watch-section-title">

                    <div>
                        <span>
                            MOVIEHUB
                        </span>

                        <h2>
                            📺 Danh sách tập
                        </h2>
                    </div>

                    <small>
                        @Model.Movie.Episodes.Count tập
                    </small>

                </div>


                <div style="
                    display: flex;
                    flex-wrap: wrap;
                    gap: 10px;
                    margin-top: 15px;
                    ">

                    @foreach (var episode in Model.Movie.Episodes
                        .OrderBy(e => e.EpisodeNumber))
                    {
                        <a asp-controller="Movies"
                           asp-action="Watch"
                           asp-route-id="@episode.Id"
                           style="
                            display: inline-flex;
                            align-items: center;
                            justify-content: center;
                            min-width: 75px;
                            height: 40px;
                            padding: 0 16px;
                            background: @(episode.Id == Model.Id ? "#e50914" : "#15151b");
                            border: 1px solid @(episode.Id == Model.Id ? "#e50914" : "#444");
                            border-radius: 7px;
                            color: white;
                            text-decoration: none;
                            font-size: 14px;
                            font-weight: 600;
                            box-sizing: border-box;
                            ">

                            Tập @episode.EpisodeNumber

                        </a>
                    }


                </div>

            </div>
        }

    </div>

</div>