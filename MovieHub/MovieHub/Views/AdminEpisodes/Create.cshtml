@model MovieHub.Models.Episode

@{
    ViewData["Title"] = "Thêm tập phim";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-8">

            <div class="card shadow">

                <div class="card-body p-4">

                    <h2 class="mb-4">
                        ➕ Thêm tập phim
                    </h2>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            @ViewBag.Error
                        </div>
                    }

                    <form method="post"
                          asp-controller="AdminEpisodes"
                          asp-action="Create">

                        @Html.AntiForgeryToken()

                        <!-- CHỌN PHIM -->
                        <div class="mb-3">

                            <label class="form-label">
                                Phim
                            </label>

                            <select asp-for="MovieId"
                                    class="form-select"
                                    required>

                                <option value="">
                                    -- Chọn phim --
                                </option>

                                @foreach (var movie in ViewBag.Movies)
                                {
                                    <option value="@movie.Id">
                                        @movie.Title
                                    </option>
                                }

                            </select>

                        </div>


                        <!-- SỐ TẬP -->
                        <div class="mb-3">

                            <label class="form-label">
                                Số tập
                            </label>

                            <input asp-for="EpisodeNumber"
                                   type="number"
                                   class="form-control"
                                   min="1"
                                   placeholder="Ví dụ: 1"
                                   required />

                        </div>


                        <!-- TÊN TẬP -->
                        <div class="mb-3">

                            <label class="form-label">
                                Tên tập
                            </label>

                            <input asp-for="Title"
                                   class="form-control"
                                   placeholder="Ví dụ: Tập 1 - Khởi đầu" />

                        </div>


                        <!-- VIDEO URL -->
                        <div class="mb-4">

                            <label class="form-label">
                                Video URL
                            </label>

                            <input asp-for="VideoUrl"
                                   class="form-control"
                                   type="url"
                                   placeholder="https://example.com/video.mp4" />

                            <div class="form-text">
                                Nhập đường dẫn trực tiếp đến file video MP4.
                            </div>

                        </div>

                        <!-- NÚT -->
                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">

                                ➕ Thêm tập

                            </button>

                            <a asp-controller="AdminEpisodes"
                               asp-action="Index"
                               class="btn btn-secondary">

                                Hủy

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>